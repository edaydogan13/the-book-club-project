rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'edaydogannn@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Books collection
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Referrals and Newsletter
    match /referrals/{referralId} {
      allow create: if request.resource.data.applicantName is string &&
                       request.resource.data.applicantEmail is string;
      allow read, update, delete: if isAdmin();
    }

    // Site configuration
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins metadata
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
